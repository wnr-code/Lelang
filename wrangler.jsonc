{
  // Konfigurasi Cloudflare Worker untuk Lelang Kebaikan Cigatas.
  // Nama worker harus sama dengan yang sudah dibuat: lelang.appwnr.workers.dev
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "lelang",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference: nama service harus sama dengan nama worker di atas.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "lelang"
    }
  ],
  // Aplikasi sepenuhnya force-dynamic + cache dummy (lihat open-next.config.ts),
  // jadi TIDAK butuh bucket R2. Binding IMAGES juga sengaja tidak dipakai:
  // foto sudah dikompres ke WebP saat upload dan next/image memakai unoptimized.
  "observability": {
    "enabled": true
  },
  // SUPABASE_URL bukan rahasia (URL proyek memang publik) — ditulis di sini
  // supaya PASTI ada di runtime setiap deploy, tidak bergantung dashboard.
  "vars": {
    "SUPABASE_URL": "https://jxpjleqzpzrjbdrxxjgv.supabase.co"
  },
  // Pertahankan variabel yang diatur lewat dashboard saat `wrangler deploy`
  // (tanpa ini, deploy akan MENGHAPUS vars dashboard yang tidak ada di file).
  "keep_vars": true
  // Secrets (SUPABASE_SERVICE_ROLE_KEY, SESSION_SECRET, PANITIA_PASSWORD)
  // diatur di dashboard Cloudflare → Settings → Variables and Secrets
  // (tipe Secret) atau via `wrangler secret put` — JANGAN ditulis di file ini.
}
