# Kata sandi login panitia (WAJIB diganti untuk pemakaian nyata)
PANITIA_PASSWORD=cigatas-berbagi

# Secret untuk menandatangani cookie sesi panitia (isi string acak panjang)
SESSION_SECRET=ganti-dengan-string-acak-yang-panjang-dan-rahasia

# ---- Supabase ----
# Untuk preview lokal: boleh dikosongkan (aplikasi memakai SQLite).
# Untuk produksi di Cloudflare Worker: WAJIB diisi (Worker tidak bisa SQLite/filesystem).
# URL proyek Supabase, mis. https://jxpjleqzpzrjbdrxxjgv.supabase.co
SUPABASE_URL=
# Service-role key (RAHASIA, hanya di server). Dapatkan dari:
# Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=
